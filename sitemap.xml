---
# Tells search engines which pages exist. The date updates itself every time the site is published.
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}{{ site.baseurl }}/</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/about/</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/faq/</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
  <url><loc>{{ site.url }}{{ site.baseurl }}/links/</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
</urlset>
